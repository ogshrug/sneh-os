#!/usr/bin/env bash
# Claude Code statusLine command (wired up by `sne agents link`).
# Claude Code pipes its status JSON to stdin, which includes the plan
# usage windows (rate_limits.five_hour / seven_day: used_percentage,
# resets_at). We keep the latest copy for the waybar agents pill
# (`sne bar agents`) and print a compact status line for Claude itself.
dir=${XDG_RUNTIME_DIR:-/tmp}/sneh
mkdir -p "$dir"
in=$(cat)
if jq -e . >/dev/null 2>&1 <<<"$in"; then
    jq -c --argjson now "$(date +%s)" '{at:$now, model:(.model.display_name // .model.id // "Claude"), rate_limits:(.rate_limits // null), cwd:(.workspace.current_dir // .cwd // "")}' <<<"$in" >"$dir/claude.json.tmp" \
        && mv -f "$dir/claude.json.tmp" "$dir/claude.json"
fi
jq -r '
  def left($t): ($t - now) as $s | if $s <= 0 then "now"
    elif $s >= 86400 then "\(($s/86400)|floor)d \((($s%86400)/3600)|floor)h"
    elif $s >= 3600 then "\(($s/3600)|floor)h \((($s%3600)/60)|floor)m"
    else "\(($s/60)|ceil)m" end;
  [ (.model.display_name // .model.id // "Claude"),
    ((.workspace.current_dir // .cwd // "") | split("/") | last // empty),
    (.rate_limits.five_hour   | select(.) | "5h \(.used_percentage|round)% · \(left(.resets_at))"),
    (.rate_limits.seven_day   | select(.) | "7d \(.used_percentage|round)%")
  ] | map(select(. != null and . != "")) | join("  ·  ")' <<<"$in" 2>/dev/null || echo "Claude"
