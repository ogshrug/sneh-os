#!/usr/bin/env bash
# Started by greetd (auto-login on tty1). Supervises Hyprland: restarts it if
# it exits, stops after a crash loop, and parks while `sne desktop off` is set
# so agents get the RAM back.
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland ELECTRON_OZONE_PLATFORM_HINT=auto
export PATH="$HOME/.local/bin:$PATH"
# Memory: no GTK accessibility bus (at-spi, ~15 MB) or dconf daemon (~6 MB);
# nothing on this desktop uses them.
export NO_AT_BRIDGE=1 GTK_A11Y=none GSETTINGS_BACKEND=memory
SNEHCFG=${XDG_CONFIG_HOME:-$HOME/.config}/sneh
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/sneh
mkdir -p "$STATE" "$SNEHCFG"
LOG=$STATE/session.log
fails=0
while :; do
    if [[ -e $SNEHCFG/desktop.off ]]; then sleep 5; continue; fi
    [[ $(stat -c %s "$LOG" 2>/dev/null || echo 0) -gt 4000000 ]] && mv -f "$LOG" "$LOG.1"
    echo "$(date -Is) starting Hyprland" >>"$LOG"
    started=$(date +%s)
    if command -v start-hyprland >/dev/null; then start-hyprland >>"$LOG" 2>&1; else Hyprland >>"$LOG" 2>&1; fi
    rc=$?
    echo "$(date -Is) Hyprland exited ($rc)" >>"$LOG"
    if (( $(date +%s) - started < 20 )); then fails=$((fails + 1)); else fails=0; fi
    if (( fails >= 5 )); then
        echo "$(date -Is) crash loop - parking the desktop (sne desktop on to retry, sne logs session)" >>"$LOG"
        touch "$SNEHCFG/desktop.off"; fails=0
    fi
    sleep 2
done
